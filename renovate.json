{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>tailor-inc/renovate-config"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "rangeStrategy": "pin",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "packageRules": [
    {
      "description": "The peer range is the supported floor; raising it is a breaking change for users, so Renovate leaves it alone.",
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },
    {
      "groupName": "oxc",
      "matchPackageNames": ["oxlint", "oxfmt"]
    },
    {
      "groupName": "type definitions",
      "matchPackageNames": ["@types/**"]
    },
    {
      "groupName": "github-actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor", "digest"]
    }
  ]
}
