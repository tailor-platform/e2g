{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@tailor-platform/e2g": ["./src/index.ts"],
      "@tailor-platform/e2g/markdown": ["./src/markdown.ts"],
      "@tailor-platform/e2g/playwright": ["./src/playwright/index.ts"],
      "@tailor-platform/e2g/playwright/reporter": ["./src/playwright/reporter/index.ts"]
    }
  },
  "include": ["src", "test", "*.ts"],
  // each of these registers its own types, so each is a project of its own
  "exclude": ["test/types/one", "test/types/two", "test/fixture-project", "test/readme"]
}
