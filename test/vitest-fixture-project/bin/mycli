#!/usr/bin/env node
const [command] = process.argv.slice(2);

if (command === "--version") {
  console.log("mycli 1.0.0");
} else if (command === "--help") {
  console.log("Usage: mycli <command>\n\nCommands:\n  init  Create a project");
} else if (command === "init") {
  const templates = ["minimal", "full"];
  let at = 0;
  const draw = () =>
    process.stdout.write(
      `\x1b[2J\x1b[H\x1b[?25lPick a template:\r\n${templates
        .map((t, i) => (i === at ? `\x1b[36m> ${t}\x1b[0m` : `  ${t}`))
        .join("\r\n")}`,
    );
  process.stdin.setRawMode(true);
  process.stdin.on("data", (data) => {
    const key = data.toString();
    if (key === "\x1b[A") at = Math.max(at - 1, 0);
    else if (key === "\x1b[B") at = Math.min(at + 1, templates.length - 1);
    else if (key === "\r") {
      process.stdout.write(`\x1b[?25h\r\nCreated demo from the ${templates[at]} template\r\n`);
      process.exit(0);
    } else if (key === "\x03") process.exit(130);
    draw();
  });
  draw();
} else {
  console.error(`unknown command: ${command}`);
  process.exit(1);
}
